# Copy to .env.local for `pnpm dev` (or rely on .env.production for builds).
# These are PUBLIC by design — security is enforced by Postgres RLS, not by the key.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxx

# Base path is read from the SHELL (vite.config.ts), not from this file:
#   VITE_BASE_PATH=./ pnpm build      (default — project site under /<repo>/)
